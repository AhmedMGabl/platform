STORAGE_CONFIG="datalake|http://huly.local:4030"
MONGO_URL=mongodb://mongodb:27017?compressors=snappy
DB_URL_PG=postgresql://postgres:example@postgres:5432
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=minioadmin&secretKey=minioadmin"
BACKUP_BUCKET_NAME=dev-backups
DB_CR_URL=postgresql://root@huly.local:26257/defaultdb?sslmode=disable
QUEUE_CONFIG=redpanda:9092

# 🌟 UNHOLY AI CONFIGURATION
# Your personal AI army is deployed!
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2000

# AI Feature Flags
ENABLE_AI_TASK_CREATION=true
ENABLE_AI_DOCUMENT_ANALYSIS=true
ENABLE_AI_CHAT_ASSISTANT=true
ENABLE_AI_CODE_ANALYSIS=true
ENABLE_AI_RISK_ANALYSIS=true
ENABLE_AI_COMMAND_CENTER=true
ENABLE_MEETING_BOT=true

# Voice Recognition
VOICE_RECOGNITION_ENABLED=true
VOICE_LANGUAGE=en-US

# Proactive AI
PROACTIVE_AI_ENABLED=true
AI_LEARNING_MODE=aggressive

# Debug Mode
UNHOLY_AI_DEBUG=true
UNHOLY_AI_LOG_LEVEL=verbose
